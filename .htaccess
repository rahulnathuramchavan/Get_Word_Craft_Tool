Options -MultiViews
RewriteEngine On
RewriteBase /

# ── Force HTTPS ──────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Force non-www (Canonical Hostname) ────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.getwordcraft\.com$ [NC]
RewriteRule ^ https://getwordcraft.com%{REQUEST_URI} [L,R=301]

# ── Gzip Compression (mod_deflate) ───────────────────────────────────────────
<IfModule mod_deflate.c>
  # Compress text, html, javascript, css, xml, json, svg
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom_xml
  AddOutputFilterByType DEFLATE image/svg+xml

  # Exclude already-compressed binary formats
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|zip|gz|tgz|bz2|mp3|ogg|wav|mp4|webm|pdf|woff2)$ no-gzip dont-vary
</IfModule>

# ── Browser Caching (mod_expires & mod_headers) ──────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Always revalidate to ensure visitors receive new deployments
  ExpiresByType text/html "access plus 0 seconds"

  # Static metadata files: moderate cache with revalidation
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"

  # Fingerprinted Vite assets (JS, CSS, SVGs): 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1. Immutable caching for Vite fingerprinted assets under /assets/
  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 2. HTML: Always check for updates
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # 3. Dynamic XML/TXT (sitemap, robots)
  <FilesMatch "\.(?:xml|txt)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=3600"
  </FilesMatch>
</IfModule>

# ── SPA fallback: serve real files/dirs directly, else return index.html ─────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [QSA,L]
